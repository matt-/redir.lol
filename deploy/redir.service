[Unit]
Description=redir - DNS rebinding / redirect security testing tool
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/redir -port 80 -dns-port 53 -domain rebind.redir.lol
Restart=on-failure
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
