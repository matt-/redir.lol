[Unit]
Description=redir - DNS rebinding / redirect security testing tool
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# systemd does not set $HOME, so config.DefaultPath() (~/.redir/config.yaml)
# would otherwise resolve to a bogus path and create a fresh empty DB.
# Point explicitly at the real config to avoid that.
ExecStart=/usr/local/bin/redir -config /root/.redir/config.yaml -port 80 -dns-port 53 -domain rebind.redir.lol
# CF_ACCOUNT_ID / CF_EMAIL_API_TOKEN for email verification (Cloudflare Email
# Sending) — not committed; create this file on the host with mode 600.
EnvironmentFile=-/etc/redir.env
Restart=on-failure
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
